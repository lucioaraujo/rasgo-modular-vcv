{"PLANAR", "curve", R"RASGO(Linear (0) ↔ constant power (1). Linear: the weights sum to 1 — the honest morph for CV. Constant power: scales the weights by 1/√Σw² so the AUDIO output does not dip ~6 dB in the middle of the square.)RASGO"},
{"PLANAR", "drift", R"RASGO(Autonomous 2D walk of the point when there is no gesture — a Lissajous of three slow incommensurable sines. Deterministic, no RNG. 0 = the point stands still.)RASGO"},
{"PLANAR", "in:a", R"RASGO(Source at the top-left corner.)RASGO"},
{"PLANAR", "in:b", R"RASGO(Source at the top-right corner.)RASGO"},
{"PLANAR", "in:c", R"RASGO(Source at the bottom-left corner.)RASGO"},
{"PLANAR", "in:d", R"RASGO(Source at the bottom-right corner.)RASGO"},
{"PLANAR", "in:gesture", R"RASGO(Gate: while high, it RECORDS the trajectory of the point (decimated 32×, up to ~4 s).)RASGO"},
{"PLANAR", "in:x", R"RASGO(CV added to X (an LFO, an envelope, another x_out…).)RASGO"},
{"PLANAR", "in:y", R"RASGO(CV added to Y.)RASGO"},
{"PLANAR", "out:out", R"RASGO(The bilinear mix of the 4 sources, with a safety softclip.)RASGO"},
{"PLANAR", "out:x_out", R"RASGO(The effective X position (already smoothed) as CV — patch it into a FILTER cutoff, a WAVETABLE pos… the gesture drives the patch.)RASGO"},
{"PLANAR", "out:y_out", R"RASGO(The effective Y position as CV.)RASGO"},
{"PLANAR", "rate", R"RASGO(Speed of the gesture loop AND of the drift. 0.5 = 1×; 2^((rate−0.5)·4), so 1/16× to 16×.)RASGO"},
{"PLANAR", "smooth", R"RASGO(One-pole glide on the point — τ from ~1 ms to ~0.5 s. From immediate response to a slew that drags the trajectory.)RASGO"},
{"PLANAR", "x", R"RASGO(Horizontal position of the point in the square (0 = the A/C side, 1 = the B/D side). Adds to the X CV.)RASGO"},
{"PLANAR", "y", R"RASGO(Vertical position (0 = the A/B side at the top, 1 = the C/D side at the bottom). Adds to the Y CV.)RASGO"},
{"PLL", "feedback_amount", R"RASGO(How much of the feedback network (FTYP) enters the phase as read.)RASGO"},
{"PLL", "feedback_type", R"RASGO(Type of feedback: direct / rectified / capacitive (slow memory) / pulse / "transistor" (asymmetric tanh) / reflux.)RASGO"},
{"PLL", "fine", R"RASGO(Fine tuning in cents.)RASGO"},
{"PLL", "fm_amount", R"RASGO(Amount of linear FM from the FM input.)RASGO"},
{"PLL", "freq", R"RASGO(Free frequency — used when REF is not connected, and as the starting point when it is.)RASGO"},
{"PLL", "in:fm", R"RASGO(Linear FM input.)RASGO"},
{"PLL", "in:pitch", R"RASGO(1 V/oct CV — multiplies FREQ.)RASGO"},
{"PLL", "in:ref", R"RASGO(External reference (a bipolar saw, e.g. OSC.saw) — present, the PLL chases its phase instead of running free.)RASGO"},
