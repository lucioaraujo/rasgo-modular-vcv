{"PLL", "near_hz", R"RASGO(The beat rate below which the frequencies count as met (Hz).)RASGO"},
{"PLL", "out:beat", R"RASGO(The beat as CV: 1 = together, 0 = 10 Hz or more.)RASGO"},
{"PLL", "out:lock", R"RASGO(0..1 — how close the phase detector is to zero (1 = locked).)RASGO"},
{"PLL", "out:meet", R"RASGO(A pulse when the frequencies meet (the beat slows) — even without LOCK.)RASGO"},
{"PLL", "out:out", R"RASGO(The waveform (SHAPE), at the frequency corrected by the phase chase.)RASGO"},
{"PLL", "out:part", R"RASGO(A pulse when they move apart again.)RASGO"},
{"PLL", "out:ring", R"RASGO(out × ref — the same classic heterodyne between two oscillators.)RASGO"},
{"PLL", "ratio", R"RASGO(Multiplies the reference's phase before comparing — the PLL locks onto sub/super-harmonics of REF, not only the same note.)RASGO"},
{"PLL", "shape", R"RASGO(Continuous morph: sine → triangle → saw → square.)RASGO"},
{"POLYGON", "cycle", R"RASGO(The length of the common cycle, in seconds (with no cable in CLK).)RASGO"},
{"POLYGON", "in:clock", R"RASGO(The clock: the cycle then lasts STEPS pulses.)RASGO"},
{"POLYGON", "in:reset", R"RASGO(Back to the start of the cycle.)RASGO"},
{"POLYGON", "n1", R"RASGO(The vertices of polygon 1 (0 = off, up to 16): N evenly spaced pulses per cycle.)RASGO"},
{"POLYGON", "n2", R"RASGO(The vertices of polygon 2 (0 = off, up to 16): N evenly spaced pulses per cycle.)RASGO"},
{"POLYGON", "n3", R"RASGO(The vertices of polygon 3 (0 = off, up to 16): N evenly spaced pulses per cycle.)RASGO"},
{"POLYGON", "n4", R"RASGO(The vertices of polygon 4 (0 = off, up to 16): N evenly spaced pulses per cycle.)RASGO"},
{"POLYGON", "out:coinc", R"RASGO(A pulse when two or more vertices land together.)RASGO"},
{"POLYGON", "out:eos", R"RASGO(A pulse at the end of each cycle, when all realign.)RASGO"},
{"POLYGON", "out:g1", R"RASGO(Polygon 1's vertices.)RASGO"},
{"POLYGON", "out:g2", R"RASGO(Polygon 2's vertices.)RASGO"},
{"POLYGON", "out:g3", R"RASGO(Polygon 3's vertices.)RASGO"},
{"POLYGON", "out:g4", R"RASGO(Polygon 4's vertices.)RASGO"},
{"POLYGON", "out:phase", R"RASGO(The position in the cycle (0..1).)RASGO"},
{"POLYGON", "phi1", R"RASGO(Rotates polygon 1 (up to one side): the same vertices, shifted.)RASGO"},
{"POLYGON", "phi2", R"RASGO(Rotates polygon 2 (up to one side): the same vertices, shifted.)RASGO"},
{"POLYGON", "phi3", R"RASGO(Rotates polygon 3 (up to one side): the same vertices, shifted.)RASGO"},
{"POLYGON", "phi4", R"RASGO(Rotates polygon 4 (up to one side): the same vertices, shifted.)RASGO"},
{"POLYGON", "steps", R"RASGO(With a cable in CLK: the cycle lasts STEPS clock pulses.)RASGO"},
{"PREDATOR", "delay", R"RASGO(The canon's maximum delay (0.2–5 s), when the predator is far away.)RASGO"},
{"PREDATOR", "hunt", R"RASGO(The hunt: with the predators high, captures now and then (each one removes prey and feeds predators).)RASGO"},
{"PREDATOR", "in:catch", R"RASGO(A trigger is a capture: the patch hunts.)RASGO"},
{"PREDATOR", "in:rate_cv", R"RASGO(V/oct CV on the cycle's speed.)RASGO"},
{"PREDATOR", "out:canon", R"RASGO(The prey line repeated with a delay that shrinks as the predator grows: the canon that closes into stretto.)RASGO"},
{"PREDATOR", "out:catch", R"RASGO(A pulse at each capture.)RASGO"},
{"PREDATOR", "out:flee", R"RASGO(A pulse at the peak of the prey: the flight.)RASGO"},
{"PREDATOR", "out:pred", R"RASGO(The predator population (0–1), a quarter cycle behind the prey.)RASGO"},
{"PREDATOR", "out:prey", R"RASGO(The prey population (0–1).)RASGO"},
{"PREDATOR", "period", R"RASGO(The length of one population cycle (4–300 s).)RASGO"},
{"PREDATOR", "size", R"RASGO(The size of the orbit: small, the populations swing a little around the balance; large, booms and crashes.)RASGO"},
{"PREDATOR", "wild", R"RASGO(The noise of the environment: it pushes the populations, and the orbit wanders between wide and narrow cycles.)RASGO"},
{"PRESSURE", "attract", R"RASGO(Positive, the particles attract (a real gas) and, if strong, condense into a droplet; negative, they repel.)RASGO"},
{"PRESSURE", "gate_len", R"RASGO(The length of the gate for each hit on the wall.)RASGO"},
{"PRESSURE", "in:heat", R"RASGO(A trigger that gives energy to all the particles at once: a burst of heat.)RASGO"},
{"PRESSURE", "in:temp_cv", R"RASGO(CV on the temperature.)RASGO"},
{"PRESSURE", "in:volume_cv", R"RASGO(CV on the volume: moves the piston.)RASGO"},
{"PRESSURE", "out:hit", R"RASGO(A gate for each particle hit on the piston.)RASGO"},
{"PRESSURE", "out:pressure", R"RASGO(The pressure on the walls (0–1): it rises with heat and compression.)RASGO"},
{"PRESSURE", "out:temperature", R"RASGO(The measured gas temperature (0–1).)RASGO"},
{"PRESSURE", "out:x", R"RASGO(The X position of one particle (−1..1): a CV that moves in straight lines and bounces.)RASGO"},
{"PRESSURE", "out:y", R"RASGO(The Y position of the same particle.)RASGO"},
{"PRESSURE", "particles", R"RASGO(How many particles are in the box (1–24): few give a sparse, irregular rhythm; many, a hiss of collisions.)RASGO"},
{"PRESSURE", "temp", R"RASGO(Temperature: the particles' mean speed. Hotter means more collisions and more pressure.)RASGO"},
{"PRESSURE", "volume", R"RASGO(The box volume: the right wall is a piston. Compressing raises the pressure and heats the gas.)RASGO"},
{"PRISM", "curve", R"RASGO(Which colour travels slowest: +1 the highs (like glass), −1 the lows (anomalous dispersion, Rasgo deviation), 0 all equal.)RASGO"},
{"PRISM", "disp", R"RASGO(Dispersion: how much the slowest colour is delayed (0–400 ms).)RASGO"},
{"PRISM", "feedback", R"RASGO(Rasgo deviation: each colour goes back into the prism — echoes that split into colours at every turn.)RASGO"},
{"PRISM", "in:disp_cv", R"RASGO(CV on dispersion (±200 ms per volt).)RASGO"},
{"PRISM", "in:in", R"RASGO(The sound to split (mono or stereo, summed).)RASGO"},
{"PRISM", "mix", R"RASGO(Dry (0) ↔ wet (1) at the OUT output.)RASGO"},
{"PRISM", "out:out", R"RASGO(The dry/wet mix (MIX), with the stereo fan.)RASGO"},
{"PRISM", "out:wet", R"RASGO(Only the colours, without the dry signal.)RASGO"},
{"PRISM", "spread", R"RASGO(The stereo fan: lows to the left, highs to the right — the rainbow in space.)RASGO"},
{"PULSAR", "formant", R"RASGO(Internal frequency of the pulsaret = the TIMBRE, INDEPENDENT of the pitch (0.1–8×, +CV). Low = hollow/formantic; high = bright/nasal. It does NOT detune.)RASGO"},
{"PULSAR", "freq", R"RASGO(Repetition rate of the pulsarets = the PITCH (20–2000 Hz, +1 V/oct CV). Each firing launches a grain; the silence between them is what defines the note.)RASGO"},
{"PULSAR", "in:formant_mod", R"RASGO(CV (in octaves) added to FORMANT — it moves the timbre without touching the pitch.)RASGO"},
{"PULSAR", "in:pitch", R"RASGO(1 V/oct CV added to FREQ.)RASGO"},
{"PULSAR", "jitter", R"RASGO(SEEDED Rasgo deviation in each pulsaret's period and amplitude — from a rigid train to an irregular cloud. Deterministic (it reproduces with the seed).)RASGO"},
{"PULSAR", "level", R"RASGO(Output, with a softclip (tanh) before it.)RASGO"},
{"PULSAR", "mask", R"RASGO(Probability of SKIPPING a pulsaret (Roads): 0 = a full train, 1 = almost all silence. It thins the texture without changing the pitch.)RASGO"},
{"PULSAR", "out:out", R"RASGO(Left channel (mono if SPREAD=0).)RASGO"},
{"PULSAR", "out:r", R"RASGO(Right channel.)RASGO"},
{"PULSAR", "shape", R"RASGO(Shape of the pulsaret: 0 = 1 cycle of a sine; up to 1 = 2–3 cycles + a high harmonic (a narrower, richer pulse).)RASGO"},
{"PULSAR", "spread", R"RASGO(Alternating pulsarets thrown to L/R (± spread) — stereo width by granulation. 0 = mono.)RASGO"},
{"PULSAR", "window", R"RASGO(Envelope of the grain: 0 ≈ rectangular (hard transients, bright), 0.4 = Hann (clean), 1 = expodec (fast attack + tail — percussive).)RASGO"},
{"QUANTIZER", "glide", R"RASGO(Portamento time between one quantised note and the next.)RASGO"},
{"QUANTIZER", "hysteresis", R"RASGO(Dead zone before changing degree — avoids flickering between two neighbouring degrees with unstable CV.)RASGO"},
{"QUANTIZER", "in:cv", R"RASGO(Continuous CV to quantise.)RASGO"},
{"QUANTIZER", "in:morph_cv", R"RASGO(CV added to MRPH (0–1).)RASGO"},
{"QUANTIZER", "in:root_cv", R"RASGO(Root by cable (semitone/12), replacing the ROOT knob — plug the ROOT output of HARMONY here.)RASGO"},
{"QUANTIZER", "in:scale_cv", R"RASGO(Scale by cable (index/11), replacing the SCALE knob — plug the SCALE output of HARMONY here.)RASGO"},
{"QUANTIZER", "in:transpose", R"RASGO(1 V/oct CV that adds before quantising — transposes the whole scale.)RASGO"},
{"QUANTIZER", "in:trigger", R"RASGO(Sample & hold — present, the note only updates on the pulse (that is how TURING/DECISION become melody).)RASGO"},
{"QUANTIZER", "morph", R"RASGO(The scale machine: A's degrees glide to B's, passing through pitches between the two; degrees only in B join from the middle. 0 = A, 1 = B.)RASGO"},
{"QUANTIZER", "out:gate", R"RASGO(Short pulse (~5 ms) every time the note really changes.)RASGO"},
{"QUANTIZER", "out:pitch", R"RASGO(Quantised CV, in 1 V/oct — ready to feed OSC.pitch.)RASGO"},
{"QUANTIZER", "out:semitone", R"RASGO(The same note, normalised to ±1 instead of octaves — useful as a control CV.)RASGO"},
{"QUANTIZER", "range", R"RASGO(How many octaves the input CV covers before quantising.)RASGO"},
{"QUANTIZER", "root", R"RASGO(Tonic of the scale (0=C ... 11=B). With a cable on the ROOT input, the cable takes over.)RASGO"},
{"QUANTIZER", "scale", R"RASGO(Musical scale (12 curated tables — chromatic, major, modes, pentatonics, whole tone, octave). With a cable on the SCL input, the cable takes over. The 13th, SIEVE, is drawn by the M1/R1/M2/R2 knobs. The 14th is the BANK: Trioio’s 2576 scales, each with its source cited — click the display to choose.)RASGO"},
{"QUANTIZER", "scale_b", R"RASGO(Scale B, where scale A (SCALE) moves to as MRPH rises.)RASGO"},
{"QUANTIZER", "sieve_and", R"RASGO(SIEVE: off = union (notes of one OR the other sieve); on = intersection (only those of both — rare scales). An empty intersection falls back to the union.)RASGO"},
{"QUANTIZER", "sieve_m1", R"RASGO(SIEVE: the 1st modulus (2–13). Notes n ≡ R1 (mod M1), counted from the tonic, are allowed. With a modulus that does not divide 12 the scale does not repeat at the octave.)RASGO"},
{"QUANTIZER", "sieve_m2", R"RASGO(SIEVE: the 2nd modulus (2–13).)RASGO"},
{"QUANTIZER", "sieve_r1", R"RASGO(SIEVE: the 1st residue — where the 1st sieve starts.)RASGO"},
{"QUANTIZER", "sieve_r2", R"RASGO(SIEVE: the 2nd residue.)RASGO"},
{"QUANTIZER", "tuning", R"RASGO(Tuning: 12-EDO (the usual temperament) · Just (pure 5-limit ratios) · Pythagorean (pure fifths) · ¼-comma meantone — these three measured from the tonic, so they follow HARMONY and KEY — · 19-EDO · 31-EDO (another grid of notes).)RASGO"},
{"REFRACT", "in:angle_cv", R"RASGO(The starting angle by CV (−1..1 = ±RANGE); replaces the sweep.)RASGO"},
{"REFRACT", "in:index_cv", R"RASGO(CV added to all the indices at once (the glass heats up).)RASGO"},
{"REFRACT", "n1", R"RASGO(The index of the 1st layer, where the light starts (1.0 air, 1.33 water, 1.5 glass, 2.4 diamond).)RASGO"},
{"REFRACT", "n2", R"RASGO(The index of the 2nd layer.)RASGO"},
{"REFRACT", "n3", R"RASGO(The index of the 3rd layer.)RASGO"},
{"REFRACT", "n4", R"RASGO(The index of the 4th layer; after it, the ray exits into air.)RASGO"},
{"REFRACT", "out:a1", R"RASGO(The ray's angle in the 1st layer (−1..1 = ±90°).)RASGO"},
{"REFRACT", "out:a2", R"RASGO(The angle in the 2nd layer.)RASGO"},
{"REFRACT", "out:a3", R"RASGO(The angle in the 3rd layer.)RASGO"},
{"REFRACT", "out:a4", R"RASGO(The angle in the 4th layer.)RASGO"},
{"REFRACT", "out:exit", R"RASGO(The ray's sideways shift as it crosses the layers (−1..1).)RASGO"},
{"REFRACT", "out:tir", R"RASGO(A pulse when the ray starts to reflect entirely (total reflection) instead of passing through.)RASGO"},
{"REFRACT", "range", R"RASGO(How far the angle sweeps (0–89°): past the critical angle, total reflection appears.)RASGO"},
{"REFRACT", "rate", R"RASGO(The speed of the starting-angle sweep (with no cable in ANG).)RASGO"},
{"REFRACT", "shimmer", R"RASGO(The mirage: the indices shimmer, like hot air over asphalt; near the critical angle, TIR becomes an irregular rhythm.)RASGO"},
{"RELATE", "in:a", R"RASGO(Voice A.)RASGO"},
{"RELATE", "in:b", R"RASGO(Voice B.)RASGO"},
{"RELATE", "intensity", R"RASGO(How strongly the relation acts.)RASGO"},
{"RELATE", "out:meeting", R"RASGO(The meeting: how much both sound at the same time (0–1).)RASGO"},
{"RELATE", "out:mix", R"RASGO(Both together, plus the friction or the ring.)RASGO"},
{"RELATE", "out:out_a", R"RASGO(Voice A, transformed by the relation.)RASGO"},
{"RELATE", "out:out_b", R"RASGO(Voice B, transformed by the relation.)RASGO"},
{"RELATE", "time", R"RASGO(The relation's time: SHADOW's delay, CONTAGION's slowness, FRICTION's repair.)RASGO"},
{"RELATE", "verb", R"RASGO(The act between the two voices: SHADOW · HOCKET · CONTAGION · FRICTION · RING.)RASGO"},
{"RESONATOR", "damp", R"RASGO(Damping of the TREBLE in the ring — the high partials decay before the low ones (a real string: bright attack, dark tail).)RASGO"},
{"RESONATOR", "decay", R"RASGO(Ring time (the resonators' Q): short = a pluck, long = a bow/drone. It never self-oscillates (poles < 1).)RASGO"},
{"RESONATOR", "freq", R"RASGO(Fundamental of the mode bank (20–5000 Hz, +1 V/oct CV). The partials are multiples of it (stretched by STRC).)RASGO"},
{"RESONATOR", "in:freq_mod", R"RASGO(1 V/oct CV added to FREQ.)RASGO"},
{"RESONATOR", "in:in", R"RASGO(The EXCITATION — hit it with whatever you like (a DRUM, NOISE, a voice). Left free → an internal noise of −36 dB bows the bank (an autonomous mode — the singing of a glass).)RASGO"},
{"RESONATOR", "in:strike", R"RASGO(Built-in exciter: each rising edge injects a burst of noise of ~3 ms (a mallet). TRIGSEQ → STRK = the bank plays a rhythm.)RASGO"},
{"RESONATOR", "mix", R"RASGO(Dry (the raw excitation) ↔ resonated. 0 = exact bypass.)RASGO"},
{"RESONATOR", "out:high", R"RASGO(The top 1/3 — it crosses with LOW when you sweep TILT.)RASGO"},
{"RESONATOR", "out:low", R"RASGO(Sum of the lowest 1/3 of the partials (with MIX).)RASGO"},
{"RESONATOR", "out:mid", R"RASGO(The middle 1/3.)RASGO"},
{"RESONATOR", "partials", R"RASGO(How many modes in the bank (1–24). 1 = almost a very resonant BP FILTER.)RASGO"},
{"RESONATOR", "position", R"RASGO(Where the excitation 'hits' — a comb over the input that zeroes some partials (the pluck point of a string; 0.5 = no even harmonics).)RASGO"},
{"RESONATOR", "structure", R"RASGO(The partials' ratios: 0 exactly harmonic (1, 2, 3…), up to 1 stretched/inharmonic (k·√(1+B·k²) — the stiffness of a bar/bell/thick string).)RASGO"},
{"RESONATOR", "tilt", R"RASGO(Spectral tilt of the amplitudes: <0 strong bass (the LOW output dominates), >0 strong treble (HIGH dominates), 0 flat. **Sweeping TILT crosses LOW↔HIGH** — the relation between the outputs is the process (Three Sisters).)RASGO"},
{"RUNGLER", "freq_a", R"RASGO(The frequency of oscillator A (0.1–4000 Hz): it is the register's clock.)RASGO"},
{"RUNGLER", "freq_b", R"RASGO(The frequency of oscillator B: its square wave is the bit that comes in.)RASGO"},
{"RUNGLER", "in:loop_cv", R"RASGO(CV added to LOOP.)RASGO"},
{"RUNGLER", "in:pitch_a", R"RASGO(V/oct into oscillator A.)RASGO"},
{"RUNGLER", "in:pitch_b", R"RASGO(V/oct into oscillator B.)RASGO"},
{"RUNGLER", "level", R"RASGO(The level of the audio outputs.)RASGO"},
{"RUNGLER", "loop", R"RASGO(Hordijk's switch: at maximum, the 8-step pattern repeats forever; in between, a new bit comes in now and then; at 0, always B's bit.)RASGO"},
{"RUNGLER", "mod_a", R"RASGO(How much the rungler modulates A's frequency.)RASGO"},
{"RUNGLER", "mod_b", R"RASGO(How much the rungler modulates B's frequency (in the opposite direction).)RASGO"},
{"RUNGLER", "out:pwm", R"RASGO(The A > B comparator: the Benjolin's raspy sound.)RASGO"},
{"RUNGLER", "out:rung", R"RASGO(The rungler's 8 steps (0–1): a sequencer that thinks for itself.)RASGO"},
{"RUNGLER", "out:tri_a", R"RASGO(A's triangle (audio).)RASGO"},
{"RUNGLER", "out:tri_b", R"RASGO(B's triangle (audio).)RASGO"},
{"SAMPLER", "in:in", R"RASGO(Audio to record (while REC is high).)RASGO"},
{"SAMPLER", "in:pitch", R"RASGO(1 V/oct CV — transposition (via speed or the pitch-shifter, according to REPIT).)RASGO"},
{"SAMPLER", "in:pos", R"RASGO(CV (0–1) that chooses the slice.)RASGO"},
{"SAMPLER", "in:rec", R"RASGO(Gate: while high, it records IN into the buffer (up to ~8 s). On the falling edge, it freezes the recorded length.)RASGO"},
{"SAMPLER", "in:trig", R"RASGO(Fires the current slice.)RASGO"},
{"SAMPLER", "loop", R"RASGO(One-shot (off) ↔ loop of the slice (on). The loop point has no crossfade yet — it may click on a very short slice.)RASGO"},
{"SAMPLER", "out:out", R"RASGO(The slice as played, with adaptive de-click at the edges.)RASGO"},
{"SAMPLER", "repitch", R"RASGO(0 = the transposition (PIT) changes the speed (varispeed). 1 = the speed is left free and the pitch comes from a pitch-shifter (the slice's duration is preserved).)RASGO"},
{"SAMPLER", "slices", R"RASGO(Divides the recorded buffer into N equal slices (1–16). The POS CV chooses which one to fire.)RASGO"},
{"SAMPLER", "speed", R"RASGO(Bipolar varispeed: sign·2^(|speed|·2) → ±0.25× to ±4×. Negative = play backwards.)RASGO"},
{"SAMPLER", "start", R"RASGO(Starting point of playback, inside the selected slice (0 = beginning, 1 = end).)RASGO"},
{"SAMPLER", "wear", R"RASGO(Wear per trigger: jitter at the starting point, sample-rate reduction and bit-crush that grow with the knob. Each trigger sounds a little different.)RASGO"},
{"SCOPE", "edge", R"RASGO(Triggers on the falling edge (on) or the rising edge (off).)RASGO"},
{"SCOPE", "hold", R"RASGO(Freezes LVL/BRT/PIT at the current value.)RASGO"},
{"SCOPE", "in:ext", R"RASGO(External trigger source — with no cable, TRIG uses IN itself.)RASGO"},
{"SCOPE", "in:in", R"RASGO(Signal to analyse/display.)RASGO"},
{"SCOPE", "out:bright", R"RASGO(Spectral centroid (treble↔bass), as CV — the higher it is, the brighter the signal.)RASGO"},
{"SCOPE", "out:conf", R"RASGO(Gate that stays on while PIT is reliable (stable period and level above silence).)RASGO"},
{"SCOPE", "out:level", R"RASGO(Signal peak, as CV — the scope's measurement goes back into the patch.)RASGO"},
{"SCOPE", "out:onset", R"RASGO(Pulse at every ATTACK/transient of the signal (fast envelope > slow × SENS). A gate of ~2 ms; it does not trigger on a steady tone.)RASGO"},
{"SCOPE", "out:pitch", R"RASGO(Detected pitch in 1 V/oct — autocorrelation (YIN) on a decimated signal, robust to harmonics (saw, chord). Range ~53–1000 Hz; noise → 0.)RASGO"},
{"SCOPE", "out:thru", R"RASGO(IN copied unchanged — it is what the panel Display draws.)RASGO"},
{"SCOPE", "out:trig", R"RASGO(Pulse when IN crosses TRIGGER in the direction of EDGE.)RASGO"},
{"SCOPE", "pit_keep", R"RASGO(On: in silence and noise, PIT holds the last reliable pitch. Off (default): PIT returns to 0 (110 Hz).)RASGO"},
{"SCOPE", "pit_oct", R"RASGO(Transposes PIT by whole octaves (−2..+2) — the oscillator that follows the input plays below or above it.)RASGO"},
{"SCOPE", "reject", R"RASGO(Hysteresis zone around the trigger level — avoids multiple triggering from noise near the threshold.)RASGO"},
{"SCOPE", "response", R"RASGO(Speed of the LVL/BRT/PIT followers — attack always much faster than the release.)RASGO"},
{"SCOPE", "sens", R"RASGO(Sensitivity of the ONSET (attack) detector: high = triggers on any rise in amplitude; low = only on strong attacks. Fast envelope vs slow.)RASGO"},
{"SCOPE", "trigger", R"RASGO(Trigger level of the comparator.)RASGO"},
{"SEASON", "day", R"RASGO(The length of one day, in seconds (5–600).)RASGO"},
{"SEASON", "hemisphere", R"RASGO(The hemisphere: in the south, the seasons are reversed (Christmas falls in summer).)RASGO"},
{"SEASON", "in:reset", R"RASGO(Returns to the dawn of the March equinox.)RASGO"},
{"SEASON", "in:speed_cv", R"RASGO(V/oct CV on the speed of time.)RASGO"},
{"SEASON", "latitude", R"RASGO(The latitude of the place: at the equator, 12 h of daylight all year; far from it, long summer days and short winter ones; above 66.6°, the midnight sun.)RASGO"},
{"SEASON", "out:dawn", R"RASGO(A pulse at sunrise.)RASGO"},
{"SEASON", "out:dusk", R"RASGO(A pulse at sunset.)RASGO"},
{"SEASON", "out:light", R"RASGO(A gate while it is day.)RASGO"},
{"SEASON", "out:scale", R"RASGO(The mode of the season, in the QUANTIZER format (patch into SCL): spring Lydian, summer Major, autumn Dorian, winter Aeolian.)RASGO"},
{"SEASON", "out:sun", R"RASGO(The height of the Sun (0 at night, 1 at the zenith).)RASGO"},
{"SEASON", "out:tempo", R"RASGO(A tempo (0–1): fastest at summer noon, slowest on a winter night.)RASGO"},
{"SEASON", "out:year", R"RASGO(The phase of the year (0 = March equinox).)RASGO"},
{"SEASON", "year", R"RASGO(How many days the year has (4–64).)RASGO"},
{"SEQUENCE", "attract", R"RASGO(CURSOR: near TARGET, positive brakes (the cursor lingers), negative speeds up (skips over).)RASGO"},
{"SEQUENCE", "fatigue", R"RASGO(Per-step fatigue: a step that plays gets tired and, too tired, stays silent that time. 0 = the usual.)RASGO"},
{"SEQUENCE", "g1", R"RASGO(Turns the gate of step 1 on/off — off, the step plays the pitch but stays mute.)RASGO"},
{"SEQUENCE", "g2", R"RASGO(Turns the gate of step 2 on/off.)RASGO"},
{"SEQUENCE", "g3", R"RASGO(Turns the gate of step 3 on/off.)RASGO"},
{"SEQUENCE", "g4", R"RASGO(Turns the gate of step 4 on/off.)RASGO"},
{"SEQUENCE", "g5", R"RASGO(Turns the gate of step 5 on/off.)RASGO"},
{"SEQUENCE", "g6", R"RASGO(Turns the gate of step 6 on/off.)RASGO"},
{"SEQUENCE", "g7", R"RASGO(Turns the gate of step 7 on/off.)RASGO"},
{"SEQUENCE", "g8", R"RASGO(Turns the gate of step 8 on/off.)RASGO"},
{"SEQUENCE", "gate_len", R"RASGO(Duty of each step's gate (internal clock) or the gate window (external clock).)RASGO"},
{"SEQUENCE", "glide", R"RASGO(Portamento between the pitch of one step and the next.)RASGO"},
{"SEQUENCE", "in:clock", R"RASGO(Advances one step on the rising edge — present, it replaces RATE.)RASGO"},
{"SEQUENCE", "in:reset", R"RASGO(Back to step 0 and restarts the direction (ping-pong/etc).)RASGO"},
{"SEQUENCE", "inertia", R"RASGO(CURSOR: how much the cursor's speed carries from one pulse to the next.)RASGO"},
{"SEQUENCE", "length", R"RASGO(How many of the 8 steps enter the pattern.)RASGO"},
{"SEQUENCE", "mode", R"RASGO(Reading direction: forward / backward / ping-pong / random / brownian.)RASGO"},
{"SEQUENCE", "out:eos", R"RASGO(Short pulse every time the sequence comes back to step 0 (end of cycle).)RASGO"},
{"SEQUENCE", "out:gate", R"RASGO(Gate of the current step (if its G_N is on).)RASGO"},
{"SEQUENCE", "out:pitch", R"RASGO(Pitch of the current step, with GLIDE applied.)RASGO"},
{"SEQUENCE", "p1", R"RASGO(Pitch of step 1 (−1..1, scaled by RANGE).)RASGO"},
{"SEQUENCE", "p2", R"RASGO(Pitch of step 2.)RASGO"},
{"SEQUENCE", "p3", R"RASGO(Pitch of step 3.)RASGO"},
{"SEQUENCE", "p4", R"RASGO(Pitch of step 4.)RASGO"},
{"SEQUENCE", "p5", R"RASGO(Pitch of step 5.)RASGO"},
{"SEQUENCE", "p6", R"RASGO(Pitch of step 6.)RASGO"},
{"SEQUENCE", "p7", R"RASGO(Pitch of step 7.)RASGO"},
{"SEQUENCE", "p8", R"RASGO(Pitch of step 8.)RASGO"},
{"SEQUENCE", "range", R"RASGO(How many octaves the P1-8 values cover.)RASGO"},
{"SEQUENCE", "rate", R"RASGO(Internal clock, used only if CLK is free.)RASGO"},
{"SEQUENCE", "target", R"RASGO(CURSOR: the step that attracts or repels.)RASGO"},
{"SH", "correlation", R"RASGO(Correlation between the two internal chances: −1 mirrored, 0 independent, 1 twins.)RASGO"},
{"SH", "in:in1", R"RASGO(Source of channel 1 — with no cable, it uses the internal draw.)RASGO"},
{"SH", "in:in2", R"RASGO(Source of channel 2 — with no cable, it uses the internal draw (correlatable with channel 1 via CORR).)RASGO"},
{"SH", "in:trig1", R"RASGO(Trigger of channel 1 — present, it replaces RATE.)RASGO"},
{"SH", "in:trig2", R"RASGO(Trigger of channel 2.)RASGO"},
{"SH", "out:out1", R"RASGO(Sampled value of channel 1, with SLW1/SLOPE applied.)RASGO"},
{"SH", "out:out2", R"RASGO(Sampled value of channel 2.)RASGO"},
{"SH", "rate", R"RASGO(Internal clock, used only if TRIG1/2 is free.)RASGO"},
{"SH", "slew1", R"RASGO(Slew time of channel 1 up to the sampled value — 0 is an instant step.)RASGO"},
{"SH", "slew2", R"RASGO(Same as SLW1, channel 2.)RASGO"},
{"SH", "slope", R"RASGO(Asymmetry of the slew: >0 it slides down slowly and rises fast (pluck portamento), <0 the opposite, 0 symmetric.)RASGO"},
{"SH", "spread", R"RASGO(Pulls the internal draw from uniform towards bell-shaped — it only affects the channels with no IN connected.)RASGO"},
{"SH", "track1", R"RASGO(TRK1 on: while the trigger stays high, it follows IN1 live (track & hold) instead of sampling only on the edge.)RASGO"},
{"SH", "track2", R"RASGO(Same as TRK1, channel 2.)RASGO"},
{"SHAPE", "drift", R"RASGO(Slow, correlated walk in the amount of folding.)RASGO"},
{"SHAPE", "fold", R"RASGO(Amount of folding — a waveshaper that reflects the signal instead of cutting it (a wavefolder).)RASGO"},
{"SHAPE", "in:fold_mod", R"RASGO(CV that adds to FOLD.)RASGO"},
{"SHAPE", "in:in", R"RASGO(Audio input to shape.)RASGO"},
{"SHAPE", "in:mod", R"RASGO(Signal for the ring-mod (multiplied by IN, mixed in via RING).)RASGO"},
{"SHAPE", "level", R"RASGO(Output gain (a built-in VCA).)RASGO"},
{"SHAPE", "out:out", R"RASGO(Audio processed by the ring→fold→wrap→sat→level chain.)RASGO"},
{"SHAPE", "ring", R"RASGO(Mixes IN with IN×MOD (four-quadrant ring-mod).)RASGO"},
{"SHAPE", "sat", R"RASGO(Saturation (tanh) after the fold.)RASGO"},
{"SHAPE", "symmetry", R"RASGO(Shifts the centre of the fold — it adds even harmonics ("buzz") instead of only odd ones.)RASGO"},
{"SHAPE", "tear", R"RASGO(The tearing fold: the reflection point changes on every cycle of the wave (at the zero crossing, so no click). 0 = the usual fold.)RASGO"},
{"SHAPE", "wrap", R"RASGO(Mixes the triangular fold (it reflects) with dry wrap-around (it cuts and re-enters from the other side).)RASGO"},
{"SHIFTER", "drift", R"RASGO(Slow, SEEDED wobble in the Δf (±drift·50 %) — the shift 'breathes', never fixed. Deterministic. 0 = static.)RASGO"},
{"SHIFTER", "feedback", R"RASGO(Part of the `up` output goes back into the input → the spectrum rises again, and again: an infinite glissando (Shepard's 'barber pole' / shimmer). A negative `feedback` pulls from `down` (it falls without stopping). `tanh` in the loop — it never blows up.)RASGO"},
{"SHIFTER", "in:in", R"RASGO(The sound to shift — a voice, a chord, a pad.)RASGO"},
{"SHIFTER", "in:shift_mod", R"RASGO(CV added to SHIFT, in Hz (1 unit = 1000 Hz). An LFO → a spectrum vibrato.)RASGO"},
{"SHIFTER", "mix", R"RASGO(Dry (IN) ↔ shifted, on BOTH outputs. 0 = bypass.)RASGO"},
{"SHIFTER", "out:down", R"RASGO(Spectrum − SHIFT (the lower band). Patch the two into different destinations — the relation between them is the process.)RASGO"},
{"SHIFTER", "out:up", R"RASGO(Spectrum + SHIFT (the upper sideband).)RASGO"},
{"SHIFTER", "shift", R"RASGO(Moves the WHOLE spectrum by so many HERTZ (−2000..2000, +CV on SFT: 1 unit = 1000 Hz). 0 = straight through. Because the shift is in Hz and not a ratio, the partials stop being harmonic → metallic, bell-like.)RASGO"},
{"SHIFTER", "tone", R"RASGO(Tilts the wet (1 pole): <0 it dulls the treble of the shifted signal, >0 it lifts it. 0 = neutral.)RASGO"},
{"SPACE", "diffusion", R"RASGO(Mixes the raw wet output with the same output passed through a chain of all-passes — from a discrete echo to a spread-out reverb tail.)RASGO"},
{"SPACE", "feedback", R"RASGO(How much of the output comes back into the delay input — more repetitions, a longer tail.)RASGO"},
{"SPACE", "in:feedback_mod", R"RASGO(CV that adds to FBK.)RASGO"},
{"SPACE", "in:in", R"RASGO(Audio input.)RASGO"},
{"SPACE", "in:time_mod", R"RASGO(CV that adds to TIME.)RASGO"},
{"SPACE", "mix", R"RASGO(Dry ↔ wet.)RASGO"},
{"SPACE", "mod", R"RASGO(Depth of a slow LFO on the read time — chorus/ensemble on the echoes.)RASGO"},
{"SPACE", "out:out", R"RASGO(Dry + wet, mixed by MIX.)RASGO"},
{"SPACE", "out:wet", R"RASGO(Only the wet part (taps + diffusion), without the dry — useful for routing the space separately from the direct signal.)RASGO"},
{"SPACE", "spread", R"RASGO(Spreads the tap times apart — 0 all together (a simple echo), 1 well distributed (a rhythmic texture).)RASGO"},
{"SPACE", "taps", R"RASGO(How many taps sum into the wet output — more taps is denser.)RASGO"},
{"SPACE", "time", R"RASGO(Base delay time.)RASGO"},
{"SPACE", "tone", R"RASGO(Brightness of the feedback — low darkens the tail at each repetition (more natural), high keeps the brightness.)RASGO"},
{"SPECTRA", "blur", R"RASGO(How FAST each voice chases the partial it inherited: 0 = it locks onto the sound (transients get through), 1 = it drags ~0.6 s (it blurs, a ghost chorus, the sound 'melts').)RASGO"},
{"SPECTRA", "freeze", R"RASGO(Freezes the voices' targets: the analysis stops, the bank goes on oscillating on the last spectrum. An infinite pad from any sound.)RASGO"},
{"SPECTRA", "in:freeze", R"RASGO(Gate: while high, it freezes (= the FRZ toggle).)RASGO"},
{"SPECTRA", "in:in", R"RASGO(The sound to ANALYSE — any voice, a DRUM, a recording. Left free → an internal noise of −30 dB with two slowly drifting partials (seeded) feeds the analysis: SPECTRA on its own is an evolving tonal drone.)RASGO"},
{"SPECTRA", "in:pitch", R"RASGO(1 V/oct CV added to SHIFT.)RASGO"},
{"SPECTRA", "jitter", R"RASGO(Slow, SEEDED wobble in each voice's frequency (±3 %·jitter) — the re-synthesis 'breathes', never identical. Deterministic. 0 = static.)RASGO"},
{"SPECTRA", "mix", R"RASGO(Dry (what comes into IN) ↔ resynthesised. 0 = bypass. With no IN, only the wet matters.)RASGO"},
{"SPECTRA", "out:out", R"RASGO(Left channel of the resynthesised bank + MIX.)RASGO"},
{"SPECTRA", "out:r", R"RASGO(Right channel — odd/even voices panned.)RASGO"},
{"SPECTRA", "shift", R"RASGO(Transposes the RE-SYNTHESIS (±2 octaves, +1 V/oct CV on PIT) without touching the analysis — a spectrum pitch-shift, formant and all.)RASGO"},
{"SPECTRA", "stretch", R"RASGO(Pushes apart/brings together the re-synthesis partials around the middle → inharmonic (a bell, metal) without changing the perceived pitch.)RASGO"},
{"SPECTRA", "tone", R"RASGO(Spectral tilt of the output: <0 it dulls the voices' treble, >0 it lifts it. 0 = faithful to the analysis.)RASGO"},
{"SPECTRA", "voices", R"RASGO(How many sinusoids the re-synthesis bank uses (2–24). Few = a caricature of the spectrum; many = a faithful re-synthesis. Each voice inherits one of the strongest partials the analysis found.)RASGO"},
{"SPRING", "damp", R"RASGO(The tone: a low-pass in the loop, from 6 kHz (bright) to ~1.2 kHz (dark).)RASGO"},
{"SPRING", "decay", R"RASGO(How long the spring sustains (loop feedback): higher, longer tail.)RASGO"},
{"SPRING", "drip", R"RASGO(How much "boing": the allpass dispersion — the lows arrive after the highs, the typical spring chirp.)RASGO"},
{"SPRING", "in:in", R"RASGO(The sound to reverberate (mono or stereo, summed into the springs).)RASGO"},
{"SPRING", "in:kick", R"RASGO(Rasgo deviation: each trigger shakes the tank — a burst of noise goes straight into the springs, the "crash" of kicking an amp.)RASGO"},
{"SPRING", "in:tension_cv", R"RASGO(CV on tension (±0.5 per volt): the spring detunes and groans, without clicks.)RASGO"},
{"SPRING", "mix", R"RASGO(Dry (0) ↔ wet (1) at the OUT output.)RASGO"},
{"SPRING", "out:out", R"RASGO(The dry/wet mix (MIX). In stereo, one spring per channel.)RASGO"},
{"SPRING", "out:wet", R"RASGO(Only the spring, without the dry signal.)RASGO"},
{"SPRING", "tension", R"RASGO(The spring's tension: the loop length, from 25 to 75 ms — short and metallic or long and loose.)RASGO"},
{"STAGES", "contour", R"RASGO(The SHAPE of the target levels: 0 a rising staircase (0→1), 0.5 an arch (0→1→0), 1 a falling staircase — a continuous blend. It is the 'drawing' of the function.)RASGO"},
{"STAGES", "curve", R"RASGO(Transition curve of each segment: <0 exponential (fast→slow), 0 linear, >0 logarithmic (slow→fast). It does nothing with HOLD=1 (there is no transition).)RASGO"},
{"STAGES", "hold", R"RASGO(0 = each segment SLIDES smoothly to the next level (a ramp — envelope/LFO); 1 = it JUMPS and holds (a step — S&H/sequence); in between, it ramps part of the way and holds the rest.)RASGO"},
{"STAGES", "in:gate", R"RASGO(One-shot mode (LOOP off): the rising edge starts a pass. Ignored in loop mode.)RASGO"},
{"STAGES", "in:rate_mod", R"RASGO(CV added to RATE.)RASGO"},
{"STAGES", "in:reset", R"RASGO(Back to segment 0.)RASGO"},
{"STAGES", "jitter", R"RASGO(Slow SEEDED walk in the levels and durations — the shape 'breathes' without ceasing to be reproducible (jitter=0 → no term at all, byte-identical).)RASGO"},
{"STAGES", "loop", R"RASGO(Runs free (a complex LFO of N segments) ↔ one shot (an envelope — it needs the GATE; it freezes at the last level until the next gate).)RASGO"},
{"STAGES", "out:eoc", R"RASGO(Pulse at the end of the round (end-of-cycle) — chain it into the RESET of another instance.)RASGO"},
{"STAGES", "out:out", R"RASGO(The function — the contour of the N segments.)RASGO"},
{"STAGES", "out:step", R"RASGO(Pulse at every segment boundary — STEP → ENVELOPE.gate chains one AD per segment.)RASGO"},
{"STAGES", "rate", R"RASGO(Speed of the round in LOOP mode (0.02–20 Hz, +CV). Each segment takes (1/rate)/segments, adjusted by TILT.)RASGO"},
{"STAGES", "segments", R"RASGO(How many steps/ramps in one round (2–8). More segments = more resolution in the shape.)RASGO"},
{"STAGES", "tilt", R"RASGO(Distortion of the durations: <0 the segments at the beginning are longer (slow attack), >0 those at the end (slow release).)RASGO"},
{"STRING", "damping", R"RASGO(Brightness — high leaves the string darker, damping harmonics faster.)RASGO"},
{"STRING", "decay", R"RASGO(Sustain — how long the string goes on sounding.)RASGO"},
{"STRING", "drive", R"RASGO(Saturates the string's loop — more grain, less clean.)RASGO"},
{"STRING", "exciter", R"RASGO(How much noise goes into the strike (PLK).)RASGO"},
{"STRING", "freq", R"RASGO(Frequency of the string — the length of the delay loop.)RASGO"},
{"STRING", "in:damp_mod", R"RASGO(CV that adds to DAMP.)RASGO"},
{"STRING", "in:freq_mod", R"RASGO(1 V/oct CV that multiplies FREQ.)RASGO"},
{"STRING", "in:in", R"RASGO(Continuous input — it excites the string like a bow, instead of a single strike.)RASGO"},
{"STRING", "in:pluck", R"RASGO(Trigger — plucks the string (a burst of noise filtered by the position).)RASGO"},
{"STRING", "mix", R"RASGO(Dry ↔ resonance of the string.)RASGO"},
{"STRING", "out:out", R"RASGO(Dry + resonance of the string, mixed by MIX.)RASGO"},
{"STRING", "position", R"RASGO(Where the string is plucked — a comb filter on the excitation, whose node at POS is not excited.)RASGO"},
{"SUM", "amt1", R"RASGO(How much of input 1 goes into the sum: from −2 (inverted and doubled) to +2; 0 leaves it out.)RASGO"},
{"SUM", "amt2", R"RASGO(How much of input 2 goes into the sum: from −2 (inverted and doubled) to +2; 0 leaves it out.)RASGO"},
{"SUM", "amt3", R"RASGO(How much of input 3 goes into the sum: from −2 (inverted and doubled) to +2; 0 leaves it out.)RASGO"},
{"SUM", "amt4", R"RASGO(How much of input 4 goes into the sum: from −2 (inverted and doubled) to +2; 0 leaves it out.)RASGO"},
{"SUM", "in:in1", R"RASGO(Input 1: any signal, CV or audio.)RASGO"},
{"SUM", "in:in2", R"RASGO(Input 2: any signal, CV or audio.)RASGO"},
{"SUM", "in:in3", R"RASGO(Input 3: any signal, CV or audio.)RASGO"},
{"SUM", "in:in4", R"RASGO(Input 4: any signal, CV or audio.)RASGO"},
{"SUM", "offset", R"RASGO(A fixed value added to the result (−1 to +1).)RASGO"},
{"SUM", "out:avg", R"RASGO(The average of the connected inputs (× the attenuverters), plus OFFSET.)RASGO"},
{"SUM", "out:inv", R"RASGO(The inverted sum (−SUM).)RASGO"},
{"SUM", "out:sum", R"RASGO(The sum: each input × its attenuverter, plus OFFSET.)RASGO"},
{"SUM", "soft", R"RASGO(On, the sum goes through a soft saturation that never exceeds ±1 — for summing audio without clipping. Off, the ceiling is ±8.)RASGO"},
{"SUPPLY", "energy", R"RASGO(The supply voltage (0–1): low, the patch sags and drifts apart; high, it gives presence back.)RASGO"},
{"SUPPLY", "in:energy_cv", R"RASGO(CV added to ENERGY.)RASGO"},
{"SUPPLY", "in:load", R"RASGO(The load: the sound that draws on the supply (the MIXER's L+R works).)RASGO"},
{"SUPPLY", "out:d1", R"RASGO(Drift 1 (V/oct, up to ±60 cents) — only with a low rail; patch it into a voice's tuning.)RASGO"},
{"SUPPLY", "out:d2", R"RASGO(Drift 2 (another voice).)RASGO"},
{"SUPPLY", "out:d3", R"RASGO(Drift 3.)RASGO"},
{"SUPPLY", "out:d4", R"RASGO(Drift 4.)RASGO"},
{"SUPPLY", "out:fail", R"RASGO(A pulse at the brownout (rail below 0.25) and another on recovery (above 0.35).)RASGO"},
{"SUPPLY", "out:rail", R"RASGO(The remaining voltage (0–1): patch it into a VCA level, a filter cutoff, the BPM (with cable gain).)RASGO"},
{"SUPPLY", "sag", R"RASGO(How much the LOAD makes the rail sag (the battery under strain).)RASGO"},
{"SUPPLY", "time", R"RASGO(How long the rail takes to sag and recover (0.05–5 s).)RASGO"},
{"SUPPLY", "wander", R"RASGO(How much the D1–D4 drifts pull the voices apart when the rail is low.)RASGO"},
{"SWARM", "cohesion", R"RASGO(From loose (0: each in its own time, heterophony) to tight (1: all on the same pulse, homorhythm).)RASGO"},
{"SWARM", "gate_len", R"RASGO(The gate length, as a fraction of the pulse.)RASGO"},
{"SWARM", "in:cohesion_cv", R"RASGO(CV added to COHES.)RASGO"},
{"SWARM", "in:lead", R"RASGO(An external clock is the leader: the whole school is pulled by it.)RASGO"},
{"SWARM", "in:scare", R"RASGO(The scare: it scatters the phases at random, and the school regroups as fast as COHES allows.)RASGO"},
{"SWARM", "out:all", R"RASGO(The pulse of the whole school (the mean phase), when there is a school.)RASGO"},
{"SWARM", "out:g1", R"RASGO(The pulse of fish 1.)RASGO"},
{"SWARM", "out:g2", R"RASGO(The pulse of fish 2.)RASGO"},
{"SWARM", "out:g3", R"RASGO(The pulse of fish 3.)RASGO"},
{"SWARM", "out:g4", R"RASGO(The pulse of fish 4.)RASGO"},
{"SWARM", "out:sync", R"RASGO(How together they are (0–1): Kuramoto's order parameter.)RASGO"},
{"SWARM", "rate", R"RASGO(The school's average tempo (0.2–16 Hz).)RASGO"},
{"SWARM", "spread", R"RASGO(How far each fish's natural tempo strays from the average.)RASGO"},
{"SWIRL", "age", R"RASGO(BBD (bucket-brigade) character: companding (it compresses before the line, expands after), a thread of seeded noise and a touch of aliasing. 0 = clean.)RASGO"},
{"SWIRL", "depth", R"RASGO(Depth of the sweep — how far the delay (or the all-passes' cutoff) moves. 0 = static colouration.)RASGO"},
{"SWIRL", "feedback", R"RASGO(Feedback (−1..1). In FLANGER/PHASER it creates the resonance (positive = a sharp comb/notch, negative = inverted). In CHORUS/ENSEMBLE a touch gives vibrato.)RASGO"},
{"SWIRL", "in:in", R"RASGO(Audio to process.)RASGO"},
{"SWIRL", "in:mix_mod", R"RASGO(CV added to MIX (the effect comes in on the attack/tail, via an ENVELOPE).)RASGO"},
{"SWIRL", "in:rate_mod", R"RASGO(CV added to RATE (a sweep off the beat).)RASGO"},
{"SWIRL", "mix", R"RASGO(Dry ↔ wet. 0 = straight through (an exact bypass).)RASGO"},
{"SWIRL", "out:l", R"RASGO(Left channel (dry + wet by MIX).)RASGO"},
{"SWIRL", "out:r", R"RASGO(Right channel — the LFO offset by SPREAD makes the image open up.)RASGO"},
{"SWIRL", "rate", R"RASGO(Speed of the (triangular) LFO that sweeps the modulation. 0.02 Hz = almost still; 8 Hz = vibrato.)RASGO"},
{"SWIRL", "spread", R"RASGO(Stereo width: the R channel's LFO is offset by spread·¼ of a cycle from the L; on the multiple voices it also spreads the detune. 0 = mono.)RASGO"},
{"SWIRL", "tone", R"RASGO(A 1-pole filter ON the wet: <0 low-pass (the 'velvety' BBD sound), >0 high-pass (it thins out, removes the bass), 0 neutral.)RASGO"},
{"SWIRL", "type", R"RASGO(0 CHORUS (2 voices, it fattens) · 1 FLANGER (1 short delay + feedback, jet/comb) · 2 ENSEMBLE (3 voices, Juno/Solina) · 3 PHASER (a cascade of all-passes, a moving notch).)RASGO"},
{"SWITCH", "dir", R"RASGO(DEMUX on: 1 input (A) distributed to N outputs according to the step. Off (MUX): N inputs to 1 output.)RASGO"},
{"SWITCH", "ghost", R"RASGO(The ghost scanner: mixes into OA what was at the previous address.)RASGO"},
{"SWITCH", "ghost_lag", R"RASGO(How many steps back the ghost reads (1–3).)RASGO"},
{"SWITCH", "glide", R"RASGO(Crossfade at the switching point — MUX mode only.)RASGO"},
{"SWITCH", "in:a", R"RASGO(Input A (MUX), or the single distributed input (DEMUX).)RASGO"},
{"SWITCH", "in:addr", R"RASGO(CV that picks the step directly (0..1 mapped over STEPS) — when present it rules, and CLK/MODE are ignored.)RASGO"},
{"SWITCH", "in:b", R"RASGO(Input B (MUX only).)RASGO"},
{"SWITCH", "in:c", R"RASGO(Input C (MUX only).)RASGO"},
{"SWITCH", "in:clock", R"RASGO(Advances one step on the rising edge (ignored if ADR is connected).)RASGO"},
{"SWITCH", "in:d", R"RASGO(Input D (MUX only).)RASGO"},
{"SWITCH", "in:reset", R"RASGO(Back to step 0.)RASGO"},
{"SWITCH", "mode", R"RASGO(Advance order: forward / ping-pong / random (never the same twice in a row) / by ADR only (ignores CLK).)RASGO"},
{"SWITCH", "out:ghost_out", R"RASGO(The input at the address from LAG steps before: the scanner's trail.)RASGO"},
{"SWITCH", "out:out", R"RASGO(MUX output (the selected A/B/C/D) — or, in DEMUX, the slice of step 0.)RASGO"},
{"SWITCH", "out:out_b", R"RASGO(In DEMUX, the slice of step 1 (otherwise always 0).)RASGO"},
{"SWITCH", "out:out_c", R"RASGO(In DEMUX, the slice of step 2.)RASGO"},
{"SWITCH", "out:out_d", R"RASGO(In DEMUX, the slice of step 3.)RASGO"},
{"SWITCH", "out:step", R"RASGO(Current position, normalised (0..1).)RASGO"},
{"SWITCH", "slew", R"RASGO(Always smooths the step of the switch (~1 ms more), anti-click in any mode.)RASGO"},
{"SWITCH", "steps", R"RASGO(How many positions the switch uses (2-4).)RASGO"},
{"TAP", "beats", R"RASGO(The bar: every how many beats the ONE comes back (1–16).)RASGO"},
{"TAP", "in:reset", R"RASGO(Forgets the tempo and the count.)RASGO"},
{"TAP", "in:tap", R"RASGO(Each trigger is a beat. Three or more in a row set the tempo; the first one is the “one”.)RASGO"},
{"TAP", "out:bpm", R"RASGO(The tempo as CV (bpm/300).)RASGO"},
{"TAP", "out:clock", R"RASGO(A pulse on every beat, at the tapped tempo — patch it into the CLOCK's EXT.)RASGO"},
{"TAP", "out:locked", R"RASGO(High when there is a tempo.)RASGO"},
{"TAP", "out:one", R"RASGO(A pulse on the downbeat (the “one”), every BAR beats.)RASGO"},
{"TAP", "spread", R"RASGO(How irregular the count may be (the largest deviation from the median). Beyond this, TAP does not invent a tempo.)RASGO"},
{"TAPE", "drive", R"RASGO(Magnetic saturation: it rounds the peaks instead of clipping them; more DRIVE, more colour and more harmonics.)RASGO"},
{"TAPE", "flutter", R"RASGO(The fast tremor of the capstan (6–11 Hz): a roughness in the pitch.)RASGO"},
{"TAPE", "hiss", R"RASGO(The oxide hiss, underneath everything.)RASGO"},
{"TAPE", "in:drive_cv", R"RASGO(CV added to DRIVE.)RASGO"},
{"TAPE", "in:in", R"RASGO(The sound that goes onto the tape.)RASGO"},
{"TAPE", "in:wear_cv", R"RASGO(CV added to WEAR.)RASGO"},
{"TAPE", "out:dropout", R"RASGO(A pulse at each dropout (for other modules to react to the failure).)RASGO"},
{"TAPE", "out:out", R"RASGO(The sound that comes back from the tape.)RASGO"},
{"TAPE", "speed", R"RASGO(The tape speed: 0 = 7.5, 1 = 15, 2 = 30 inches per second. Slower is darker and wobblier.)RASGO"},
{"TAPE", "wear", R"RASGO(Worn tape: dropouts (the level suddenly falls, more muffled) and bursts of flutter when it crinkles. 0 = new tape.)RASGO"},
{"TAPE", "wow", R"RASGO(The slow wobble of the motor (0.3–1.2 Hz): the pitch sways.)RASGO"},
{"TEMPO", "accel", R"RASGO(How much the tempo speeds up with tension (0 to 30 %): the accelerando toward the climax.)RASGO"},
{"TEMPO", "arch_depth", R"RASGO(The phrase arch: faster in the middle, slower at the ends (Todd); the phrase lasts the same.)RASGO"},
{"TEMPO", "fermata_len", R"RASGO(How many beats the fermata holds the clock.)RASGO"},
{"TEMPO", "final", R"RASGO(The arrival tempo of the final ritardando, as a fraction of the tempo (0.6 = 60 %).)RASGO"},
{"TEMPO", "in:clock", R"RASGO(The clock that counts the phrase's beats (e.g. CLOCK's CLK).)RASGO"},
{"TEMPO", "in:coda", R"RASGO(Coda gate (FORM's END): starts the final ritardando.)RASGO"},
{"TEMPO", "in:fermata", R"RASGO(A pulse here makes a fermata: the clock holds and comes back.)RASGO"},
{"TEMPO", "in:section", R"RASGO(A section-change pulse (FORM's SECT): the tempo jumps a little and waits.)RASGO"},
{"TEMPO", "in:tension", R"RASGO(The tension (0–1), e.g. FORM's TENS: speeds up toward the climax.)RASGO"},
{"TEMPO", "mode", R"RASGO(0 STRICT (only the shape and the ritardando), 1 ARCH (plus the phrase arch), 2 ELASTIC (plus the rubato).)RASGO"},
{"TEMPO", "out:arch", R"RASGO(The phrase arch (0–1), so dynamics follow the tempo — patch it into a VCA or FORM's ENV.)RASGO"},
{"TEMPO", "out:beat", R"RASGO(The beat with the tempo already shaped, for modules that do not go through CLOCK.)RASGO"},
{"TEMPO", "out:end", R"RASGO(High when the final ritardando arrives.)RASGO"},
{"TEMPO", "out:rate", R"RASGO(The tempo as a ratio in volts per octave: patch it into CLOCK's RATE (0 V = the knob's tempo, 1 V = double).)RASGO"},
{"TEMPO", "phrase", R"RASGO(The phrase length in beats: the arch and the rubato close at each phrase.)RASGO"},
{"TEMPO", "ritard", R"RASGO(How long the final ritardando lasts, in seconds.)RASGO"},
{"TEMPO", "rubato", R"RASGO(The rubato: borrowed time is given back within the phrase (ELASTIC mode only).)RASGO"},
{"TEMPO", "seed", R"RASGO(The seed of the tempo jumps and the rubato phases.)RASGO"},
{"TEMPO", "shape", R"RASGO(The ritardando's curve (the stopping-runner model): 1 slows evenly, 4 holds and brakes at the end.)RASGO"},
{"TEMPO", "spring", R"RASGO(The spring linking tempo changes: low is lazy, high follows quickly. There is never a step.)RASGO"},
{"TRIGSEQ", "chaos", R"RASGO(Probability of ghost notes appearing or expected triggers failing — it humanises, it is not a raw flip.)RASGO"},
{"TRIGSEQ", "density1", R"RASGO(Trigger threshold of line 1 (kick) — the higher it is, the more steps trigger.)RASGO"},
{"TRIGSEQ", "density2", R"RASGO(Threshold of line 2 (snare).)RASGO"},
{"TRIGSEQ", "density3", R"RASGO(Threshold of line 3 (hi-hat).)RASGO"},
{"TRIGSEQ", "density4", R"RASGO(Threshold of line 4 (perc).)RASGO"},
{"TRIGSEQ", "drift", R"RASGO(Slow, bounded walk in MAP and in the densities — the groove evolves on its own, little by little.)RASGO"},
{"TRIGSEQ", "fill_amt", R"RASGO(How much FILL pushes the densities up, temporarily.)RASGO"},
{"TRIGSEQ", "in:clock", R"RASGO(Advances one step on the rising edge — present, it replaces RATE.)RASGO"},
{"TRIGSEQ", "in:fill", R"RASGO(Gate — a high level pushes the densities up (FILL_AMT), for a turnaround.)RASGO"},
{"TRIGSEQ", "in:map_cv", R"RASGO(CV that adds to MAP.)RASGO"},
{"TRIGSEQ", "in:reset", R"RASGO(Back to step 0.)RASGO"},
{"TRIGSEQ", "length", R"RASGO(How many of the 16 steps enter the cycle.)RASGO"},
{"TRIGSEQ", "map", R"RASGO(Morphs between 4 rhythmic characters: straight (rock/house) / broken (breakbeat) / swung (hip-hop) / sparse (minimal/dub).)RASGO"},
{"TRIGSEQ", "out:accent", R"RASGO(Triggers when 2 or more lines coincide on the same step.)RASGO"},
{"TRIGSEQ", "out:any", R"RASGO(OR of the 4 lines — triggers if any of them plays.)RASGO"},
{"TRIGSEQ", "out:t1", R"RASGO(Gate of line 1 (kick).)RASGO"},
{"TRIGSEQ", "out:t2", R"RASGO(Gate of line 2 (snare).)RASGO"},
{"TRIGSEQ", "out:t3", R"RASGO(Gate of line 3 (hi-hat).)RASGO"},
{"TRIGSEQ", "out:t4", R"RASGO(Gate of line 4 (perc).)RASGO"},
{"TRIGSEQ", "ratchet", R"RASGO(Probability of a trigger turning into a burst of fast repetitions.)RASGO"},
{"TRIGSEQ", "rate", R"RASGO(Internal clock, used only if CLK is free.)RASGO"},
{"TRIGSEQ", "swing", R"RASGO(Delays the odd steps.)RASGO"},
{"TURING", "in:clock", R"RASGO(Advances the register one step on the rising edge — present, it replaces RATE.)RASGO"},
{"TURING", "in:lock_mod", R"RASGO(CV that adds to LOCK.)RASGO"},
{"TURING", "length", R"RASGO(Number of stages of the shift register — the size of the loop that can get locked.)RASGO"},
{"TURING", "lock", R"RASGO(Probability of the loop being PRESERVED instead of changing at each step — 0 is pure chance, 1 is a locked loop (repeats forever).)RASGO"},
{"TURING", "mutate", R"RASGO(When the loop changes, how much: near 0 it is a small mutation (noise over the old value), 1 is a completely new draw.)RASGO"},
{"TURING", "offset", R"RASGO(Centre of the CV output.)RASGO"},
{"TURING", "out:cv", R"RASGO(The front of the register, bipolar, scaled by RANGE/OFST and quantised by STEPS.)RASGO"},
{"TURING", "out:cv2", R"RASGO(Weighted sum of 4 stages of the register — a second CV correlated with CV, but different (the original Turing Machine's "Volts expander").)RASGO"},
{"TURING", "out:pulse", R"RASGO(The front stage as a bit (0 or 1) — a gate derived from the same chance/memory (the "Pulses expander").)RASGO"},
{"TURING", "range", R"RASGO(Span of the CV output, around OFST.)RASGO"},
{"TURING", "rate", R"RASGO(Internal clock, used only if CLK is free.)RASGO"},
{"TURING", "steps", R"RASGO(Quantises CV into STEPS levels — 1 is continuous.)RASGO"},
{"TURNTABLE", "friction", R"RASGO(Friction: how fast the platter stops on BRK (a short or long coast) and how much it 'comes back' on its own after a scratch.)RASGO"},
{"TURNTABLE", "grab", R"RASGO(Firmness of the hand: how much the SCR CV throws the platter. A small SCR = pitch-bend (a little push for beatmatching); a large, oscillating SCR = a real scratch.)RASGO"},
{"TURNTABLE", "in:brake", R"RASGO(Gate: while high, the motor lets go and the platter stops (a coast governed by FRIC). Release the gate and the motor pulls it back.)RASGO"},
{"TURNTABLE", "in:in", R"RASGO(Audio to record (while REC is high).)RASGO"},
{"TURNTABLE", "in:rec", R"RASGO(Gate: while high, it records IN into the buffer (up to ~8 s). On the falling edge, it freezes the length — you cannot play and record at the same time.)RASGO"},
{"TURNTABLE", "in:scratch", R"RASGO(The hand, as bipolar CV. An LFO and a DJ's hand are interchangeable here.)RASGO"},
{"TURNTABLE", "in:trig", R"RASGO(Drops the needle: readPos = START·length, a ramp of ~5 ms (no click) and it TURNS the motor on. After the 1st trig the motor stays on.)RASGO"},
{"TURNTABLE", "loop", R"RASGO(One-shot (the record 'ends' and locks on the last sample) ↔ a locked groove (the read goes round the buffer).)RASGO"},
{"TURNTABLE", "out:out", R"RASGO(The recorded material as read by the platter, with AC coupling (no DC step when the platter stops).)RASGO"},
{"TURNTABLE", "speed", R"RASGO(Target speed of the platter: sign·2^|speed| → ±0.5× to ±2× (33⅓ ↔ 45 ↔ slow). Negative = the record spinning backwards.)RASGO"},
{"TURNTABLE", "start", R"RASGO(Where the needle drops (the position on the record) on the rising edge of TRIG.)RASGO"},
{"TURNTABLE", "torque", R"RASGO(Strength of the motor: how fast the platter REACHES the speed. Low = a long start-up 'wow' (~1 s); high = almost instant.)RASGO"},
{"TURNTABLE", "wear", R"RASGO(Vinyl wear: growing crackle/clicks + a slight instability of rotation + a minimal drop in level.)RASGO"},
{"VCA", "cv1_amount", R"RASGO(Attenuverter of the CV1 input (−1..1) — it adds to LVL1.)RASGO"},
{"VCA", "cv2_amount", R"RASGO(Attenuverter of the CV2 input (−1..1) — it adds to LVL2.)RASGO"},
{"VCA", "drift", R"RASGO(Slow, correlated oscillation in both gains (±~3% at most) — "the VCA breathes".)RASGO"},
{"VCA", "in:cv1", R"RASGO(CV controlling the gain of channel 1.)RASGO"},
{"VCA", "in:cv2", R"RASGO(CV controlling the gain of channel 2.)RASGO"},
{"VCA", "in:in1", R"RASGO(Audio or CV input of channel 1.)RASGO"},
{"VCA", "in:in2", R"RASGO(Audio or CV input of channel 2.)RASGO"},
{"VCA", "level1", R"RASGO(Manual gain of channel 1.)RASGO"},
{"VCA", "level2", R"RASGO(Manual gain of channel 2 (the same as channel 1).)RASGO"},
{"VCA", "out:out1", R"RASGO(Output of channel 1.)RASGO"},
{"VCA", "out:out2", R"RASGO(Output of channel 2.)RASGO"},
{"VCA", "out:sum", R"RASGO(out1 + out2, with a soft ceiling — a free 2-channel mini-mixer.)RASGO"},
{"VCA", "response1", R"RASGO(0 = linear (good for summing CV), 1 = exponential ("dB-linear", good for audio volume).)RASGO"},
{"VCA", "response2", R"RASGO(The same as RSP1, for channel 2.)RASGO"},
{"VCA", "saturation", R"RASGO(The colour of the differential pair (OTA): saturates the INPUT before the gain, so the character does not depend on the volume. 0 = the usual clean VCA; 1 = well saturated (antialiased).)RASGO"},
{"VCA4", "curve", R"RASGO(SHARED: 0 = linear (good for summing CV), 1 = exponential (dB-linear, good for perceived audio volume). `gain^(1+3·curve)`.)RASGO"},
{"VCA4", "cv1_amt", R"RASGO(Attenuverter of CV1 (−1..1) — it adds to LVL1. Negative INVERTS the CV's action.)RASGO"},
{"VCA4", "cv2_amt", R"RASGO(Attenuverter of CV2.)RASGO"},
{"VCA4", "cv3_amt", R"RASGO(Attenuverter of CV3.)RASGO"},
{"VCA4", "cv4_amt", R"RASGO(Attenuverter of CV4.)RASGO"},
{"VCA4", "drift", R"RASGO(Slow, SEEDED oscillation in the 4 gains (±~3 %) — the bank breathes. Deterministic. 0 = static.)RASGO"},
{"VCA4", "in:cv1", R"RASGO(CV of the gain of channel 1.)RASGO"},
{"VCA4", "in:cv2", R"RASGO(CV of the gain of channel 2.)RASGO"},
{"VCA4", "in:cv3", R"RASGO(CV of the gain of channel 3.)RASGO"},
{"VCA4", "in:cv4", R"RASGO(CV of the gain of channel 4.)RASGO"},
{"VCA4", "in:in1", R"RASGO(Audio (or CV) of channel 1.)RASGO"},
{"VCA4", "in:in2", R"RASGO(Audio of channel 2.)RASGO"},
{"VCA4", "in:in3", R"RASGO(Audio of channel 3.)RASGO"},
{"VCA4", "in:in4", R"RASGO(Audio of channel 4.)RASGO"},
{"VCA4", "level1", R"RASGO(Manual gain of channel 1 (the knob that CV1 adds to — modulation by PORT, the knob stays alive).)RASGO"},
{"VCA4", "level2", R"RASGO(Manual gain of channel 2.)RASGO"},
{"VCA4", "level3", R"RASGO(Manual gain of channel 3.)RASGO"},
{"VCA4", "level4", R"RASGO(Manual gain of channel 4.)RASGO"},
{"VCA4", "mix_gain", R"RASGO(Gain of the MIX output (0–2×) — the sum of the 4 channels with a soft ceiling. A free 4-channel mixer.)RASGO"},
{"VCA4", "out:mix", R"RASGO(Sum of the 4 channels × MIXG, with a soft ceiling.)RASGO"},
{"VCA4", "out:out1", R"RASGO(Output of channel 1.)RASGO"},
{"VCA4", "out:out2", R"RASGO(Output of channel 2.)RASGO"},
{"VCA4", "out:out3", R"RASGO(Output of channel 3.)RASGO"},
{"VCA4", "out:out4", R"RASGO(Output of channel 4.)RASGO"},
{"VCA4", "saturation", R"RASGO(SAT: the OTA differential-pair saturation at each channel's input, the same as the VCA's — it rounds and thickens the sound at high gain. At 0, VCA4 is clean.)RASGO"},
{"VERSUS", "hysteresis", R"RASGO(Hysteresis: COMP rises above THR + HYST/2 and falls below THR − HYST/2 — it does not flicker with noise.)RASGO"},
{"VERSUS", "in:a", R"RASGO(Signal A (audio or CV).)RASGO"},
{"VERSUS", "in:b", R"RASGO(Signal B (audio or CV).)RASGO"},
{"VERSUS", "in:threshold_cv", R"RASGO(CV added to the threshold: the threshold can move.)RASGO"},
{"VERSUS", "offset", R"RASGO(An offset added to MIX.)RASGO"},
{"VERSUS", "out:comp", R"RASGO(The decision: high while MIX is above the threshold.)RASGO"},
{"VERSUS", "out:cross", R"RASGO(A pulse at each COMP change (rise and fall).)RASGO"},
{"VERSUS", "out:inv", R"RASGO(MIX inverted.)RASGO"},
{"VERSUS", "out:mix", R"RASGO(A·A + B·B + OFS: add, oppose or cancel.)RASGO"},
{"VERSUS", "pol_a", R"RASGO(How much of A goes into MIX, with zero in the centre: right adds, left goes in inverted.)RASGO"},
{"VERSUS", "pol_b", R"RASGO(How much of B goes into MIX, with zero in the centre (default: inverted — MIX is the difference A − B).)RASGO"},
{"VERSUS", "threshold", R"RASGO(The COMP threshold: the gate is high while MIX is above it.)RASGO"},
{"VIA", "body", R"RASGO(The SPEAKER body's frequency (40–400 Hz).)RASGO"},
{"VIA", "capacitor", R"RASGO(CAP gate: the capacitor's state — the path remembers and lets go slowly (MEM).)RASGO"},
{"VIA", "diode", R"RASGO(DIODE gate: the rectified signal (|x|·2 − 1) — the frequency doubles.)RASGO"},
{"VIA", "in:in", R"RASGO(What goes through VIA (any cable: audio or CV).)RASGO"},
{"VIA", "in:memory_cv", R"RASGO(CV on the capacitor's time (+1 = 16× slower).)RASGO"},
{"VIA", "level", R"RASGO(The output level.)RASGO"},
{"VIA", "memory", R"RASGO(The capacitor's charge time (1 ms – 2 s).)RASGO"},
{"VIA", "out:cap", R"RASGO(The capacitor's state, as CV.)RASGO"},
{"VIA", "out:out", R"RASGO(The average of the open gates (the composite return).)RASGO"},
{"VIA", "pulse", R"RASGO(PULSE gate: only the edge — the signal turned into a threshold.)RASGO"},
{"VIA", "reflux", R"RASGO(REFLUX gate: the signal minus the capacitor's memory — a current that returns altered.)RASGO"},
{"VIA", "res", R"RASGO(RES gate: the signal passes (the resistor).)RASGO"},
{"VIA", "speaker", R"RASGO(SPEAKER gate: a body resonating at BODY that saturates — the cone hitting its limit.)RASGO"},
{"VIA", "transistor", R"RASGO(TRANS gate: an asymmetric tanh with the capacitor (the transistor).)RASGO"},
{"VOCODER", "attack", R"RASGO(Attack of the envelope followers (1–60 ms). Short = the consonants cut dry; long = everything softens.)RASGO"},
{"VOCODER", "bands", R"RASGO(How many frequency bands (4–20). Few = a coarse 'robot'; many (16–20) = intelligible speech.)RASGO"},
{"VOCODER", "freeze", R"RASGO(Freezes the bands' envelopes — the carrier stays 'speaking the last syllable' forever. Remove the MOD after freezing and the pad holds.)RASGO"},
{"VOCODER", "in:carrier", R"RASGO(The CARRIER — what is going to 'speak' (a rich saw, a pad, a chord, noise). Left free → an internal saw tunable by PIT.)RASGO"},
{"VOCODER", "in:mod", R"RASGO(The MODULATOR — the voice/speech (or a DRUM, or any rhythmic sound) whose spectral envelope shapes the carrier.)RASGO"},
{"VOCODER", "in:pitch", R"RASGO(1 V/oct CV for the internal saw (only when CAR is free).)RASGO"},
{"VOCODER", "mix", R"RASGO(Dry carrier ↔ vocoded. 0 = bypass.)RASGO"},
{"VOCODER", "out:out", R"RASGO(The carrier shaped by the modulator's bands + sibilance, with softclip.)RASGO"},
{"VOCODER", "release", R"RASGO(Release (20–600 ms). Short = staccato/intelligible; long = the syllables blur into one another (a spoken pad).)RASGO"},
{"VOCODER", "shift", R"RASGO(Shifts the SYNTHESIS frequencies relative to the analysis (2^(shift·1.2)) — a formant shift: up = a small voice, down = a big voice, without changing the speech.)RASGO"},
{"VOCODER", "sibilance", R"RASGO(How much of the modulator's TREBLE (> ~3.5 kHz) passes STRAIGHT through — the fricatives (s, f, sh) that band analysis does not catch. 0 = a lisp; high = crisp speech.)RASGO"},
{"VOLTA", "erode", R"RASGO(How many steps go silent (the pulse drops, the CV holds), also in a fixed order.)RASGO"},
{"VOLTA", "in:clock", R"RASGO(External clock: each pulse advances one step.)RASGO"},
{"VOLTA", "in:ero_cv", R"RASGO(CV added to ERODE.)RASGO"},
{"VOLTA", "in:mut_cv", R"RASGO(CV added to MUT.)RASGO"},
{"VOLTA", "in:new", R"RASGO(A pulse here replaces the base loop with a new one — the only way the base changes.)RASGO"},
{"VOLTA", "in:reset", R"RASGO(Back to the first step.)RASGO"},
{"VOLTA", "length", R"RASGO(How many steps the loop has (2 to 16).)RASGO"},
{"VOLTA", "mutate", R"RASGO(How many steps switch to their alternative value, always in the same order. Turning the knob back returns the exact loop.)RASGO"},
{"VOLTA", "offset", R"RASGO(An offset added to the CV.)RASGO"},
{"VOLTA", "out:cv", R"RASGO(The step's value, as in TURING.)RASGO"},
{"VOLTA", "out:cv2", R"RASGO(The step blended with the next two.)RASGO"},
{"VOLTA", "out:pos", R"RASGO(The position in the loop (0–1).)RASGO"},
{"VOLTA", "out:pulse", R"RASGO(A gate on the high steps that were not silenced.)RASGO"},
{"VOLTA", "protect", R"RASGO(The memory: protected steps neither change nor go silent.)RASGO"},
{"VOLTA", "range", R"RASGO(The CV's amplitude.)RASGO"},
{"VOLTA", "rate", R"RASGO(The internal clock rate (without CLK).)RASGO"},
{"VOLTA", "seed", R"RASGO(The seed of the base loop and of the transformation order.)RASGO"},
{"VOLTA", "steps", R"RASGO(How many steps the CV is quantized to (1 = continuous).)RASGO"},
{"WASP", "bias", R"RASGO(Asymmetric ceiling — it adds even harmonics (more "buzz") and blocks DC.)RASGO"},
{"WASP", "cutoff", R"RASGO(Cutoff frequency.)RASGO"},
{"WASP", "drift", R"RASGO(Slow, correlated walk in the cutoff/resonance.)RASGO"},
{"WASP", "drive", R"RASGO(Input gain — it pushes the signal into the clipper BEFORE the filter.)RASGO"},
{"WASP", "grit", R"RASGO(Knee of the clipper in the loop — the more GRIT, the earlier and harder it clips.)RASGO"},
{"WASP", "in:cutoff_mod", R"RASGO(CV that adds to CUT.)RASGO"},
{"WASP", "in:in", R"RASGO(Audio input.)RASGO"},
{"WASP", "in:res_mod", R"RASGO(CV that adds to RESO.)RASGO"},
{"WASP", "mode", R"RASGO(LP ↔ BP ↔ HP.)RASGO"},
{"WASP", "out:out", R"RASGO(Filtered/clipped output.)RASGO"},
{"WASP", "resonance", R"RASGO(Resonance — near 1 the filter self-oscillates, more "reedy" than the ordinary FILTER.)RASGO"},
{"WAVETABLE", "deform", R"RASGO(How much the table is deformed (0 = the usual).)RASGO"},
{"WAVETABLE", "deform_mode", R"RASGO(FOLD (the shape folded onto itself) or TEAR (each cycle, the reading jumps to another point of the table, click-free).)RASGO"},
{"WAVETABLE", "drift", R"RASGO(Slow autonomous sweep of POS — the wavetable breathes. 0 = deterministic.)RASGO"},
{"WAVETABLE", "fine", R"RASGO(Fine tuning in cents (±100).)RASGO"},
{"WAVETABLE", "fm_amount", R"RASGO(Depth of the linear FM from the FM input.)RASGO"},
{"WAVETABLE", "freq", R"RASGO(Base frequency. 1 V/oct through the 1V/O input.)RASGO"},
{"WAVETABLE", "in:capture", R"RASGO(Audio to capture as a table — from an AUDIO-IN, an OSC, any audio output in the graph.)RASGO"},
{"WAVETABLE", "in:fm", R"RASGO(Audio for linear FM (× FM_AMOUNT).)RASGO"},
{"WAVETABLE", "in:grab", R"RASGO(Trigger: on the rising edge, it takes 1024 samples of CAPTURE (DC removed + normalised) — it becomes the frame at the top of POS (a crossfade from ~0.9 to 1.0). No pitch detection: tune the source by ear.)RASGO"},
{"WAVETABLE", "in:pitch", R"RASGO(1 V/oct CV.)RASGO"},
{"WAVETABLE", "in:pos", R"RASGO(CV added to POS (an LFO, an envelope, DRIFT…).)RASGO"},
{"WAVETABLE", "out:out", R"RASGO(The waveform as swept.)RASGO"},
{"WAVETABLE", "pos", R"RASGO(Position on the SHAPE axis: 0 = saw, ⅓ = square, ⅔ = formant (a vowel), 1 = sine. It adds to the POS CV and to DRIFT.)RASGO"},
{"WAVETABLE", "warp", R"RASGO(Phase distortion (Casio CZ / the WAVE-6's WAVE CUT): it compresses the first half of the cycle into a shrinking window — from identity (0) to a bright near-pulse (1).)RASGO"},
