{"PARAMETRIC", "type2", R"RASGO(Type of stage 2 (the same options as TYPE1).)RASGO"},
{"PARAMETRIC", "type3", R"RASGO(Type of stage 3.)RASGO"},
{"PARAMETRIC", "type4", R"RASGO(Type of stage 4.)RASGO"},
