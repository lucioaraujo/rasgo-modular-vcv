{"MATRIX", "g21", R"RASGO(Gain of IN2 → OUT1.)RASGO"},
{"MATRIX", "g22", R"RASGO(Gain of IN2 → OUT2 (the diagonal — default 1).)RASGO"},
{"MATRIX", "g23", R"RASGO(Gain of IN2 → OUT3.)RASGO"},
{"MATRIX", "g24", R"RASGO(Gain of IN2 → OUT4.)RASGO"},
{"MATRIX", "g31", R"RASGO(Gain of IN3 → OUT1.)RASGO"},
{"MATRIX", "g32", R"RASGO(Gain of IN3 → OUT2.)RASGO"},
{"MATRIX", "g33", R"RASGO(Gain of IN3 → OUT3 (the diagonal — default 1).)RASGO"},
{"MATRIX", "g34", R"RASGO(Gain of IN3 → OUT4.)RASGO"},
{"MATRIX", "g41", R"RASGO(Gain of IN4 → OUT1.)RASGO"},
{"MATRIX", "g42", R"RASGO(Gain of IN4 → OUT2.)RASGO"},
{"MATRIX", "g43", R"RASGO(Gain of IN4 → OUT3.)RASGO"},
{"MATRIX", "g44", R"RASGO(Gain of IN4 → OUT4 (the diagonal — default 1).)RASGO"},
{"MATRIX", "history", R"RASGO(Routes with history: a used path widens (up to 1.2×), an abandoned one narrows (down to 0.3×); the matrix forgets after ~1 minute unused.)RASGO"},
{"MATRIX", "in:in1", R"RASGO(Matrix input 1.)RASGO"},
{"MATRIX", "in:in2", R"RASGO(Matrix input 2.)RASGO"},
{"MATRIX", "in:in3", R"RASGO(Matrix input 3.)RASGO"},
{"MATRIX", "in:in4", R"RASGO(Matrix input 4.)RASGO"},
{"MATRIX", "level", R"RASGO(Overall output gain, before SAT.)RASGO"},
{"MATRIX", "norm", R"RASGO(Per-column normalisation — keeps the output level steady even with several high gains summed into the same destination.)RASGO"},
{"MATRIX", "out:out1", R"RASGO(Weighted sum of column 1 (every input × its g_1 gains).)RASGO"},
{"MATRIX", "out:out2", R"RASGO(Weighted sum of column 2.)RASGO"},
{"MATRIX", "out:out3", R"RASGO(Weighted sum of column 3.)RASGO"},
{"MATRIX", "out:out4", R"RASGO(Weighted sum of column 4.)RASGO"},
{"MATRIX", "ring", R"RASGO(Crosses each column between linear sum (0) and four-quadrant ring-mod (1) — two non-zero inputs into the same destination start to multiply instead of adding.)RASGO"},
{"MATRIX", "sat", R"RASGO(Saturates the matrix gently — it holds even inside a feedback loop.)RASGO"},
{"MATTER", "brightness", R"RASGO(How many high modes sound — the amplitude rolloff per mode.)RASGO"},
{"MATTER", "damping", R"RASGO(How long the modes go on sounding after being excited.)RASGO"},
{"MATTER", "exciter", R"RASGO(How much noise goes into the internal strike's burst.)RASGO"},
{"MATTER", "freq", R"RASGO(Fundamental frequency of the mode bank.)RASGO"},
{"MATTER", "in:freq_mod", R"RASGO(1 V/oct CV that multiplies FREQ.)RASGO"},
{"MATTER", "in:in", R"RASGO(Audio input to excite the modes (a click, noise, a voice).)RASGO"},
{"MATTER", "in:strike", R"RASGO(Trigger — fires an internal strike (a short burst of noise).)RASGO"},
{"MATTER", "in:struct_mod", R"RASGO(CV that adds to STRC.)RASGO"},
{"MATTER", "mix", R"RASGO(Dry (raw excitation) ↔ wet (resonance of the modes).)RASGO"},
{"MATTER", "out:out", R"RASGO(Mix between the raw excitation and the resonance of the 24 modes.)RASGO"},
{"MATTER", "position", R"RASGO(Where the object is excited — it decides WHICH modes receive energy (playing on a harmonic's node does not excite it).)RASGO"},
{"MATTER", "structure", R"RASGO(String (0, harmonic modes) → bell/metal (1, stretched/inharmonic modes).)RASGO"},
{"MEMORY", "blend", R"RASGO(Dry (raw input) ↔ wet (the cloud of grains).)RASGO"},
{"MEMORY", "density", R"RASGO(How many new grains are born per second.)RASGO"},
{"MEMORY", "feedback", R"RASGO(Feeds the output back into the buffer before recording — the material accumulates/degenerates.)RASGO"},
{"MEMORY", "freeze", R"RASGO(Stops the recording — the buffer becomes a fixed texture, only the grains keep re-reading.)RASGO"},
{"MEMORY", "grain", R"RASGO(Duration of each grain.)RASGO"},
{"MEMORY", "in:freeze_gate", R"RASGO(Gate — a high level freezes the buffer, the same as the HOLD toggle.)RASGO"},
{"MEMORY", "in:in", R"RASGO(Audio input, recorded continuously into the buffer (except with FREEZE).)RASGO"},
{"MEMORY", "in:pitch_mod", R"RASGO(1 V/oct CV that adds to PITCH (in octaves).)RASGO"},
{"MEMORY", "in:position_mod", R"RASGO(CV that adds to POS.)RASGO"},
{"MEMORY", "out:out", R"RASGO(Mix between the raw input and the cloud of grains.)RASGO"},
{"MEMORY", "pitch", R"RASGO(Transposition of the grains' read, in semitones (±24).)RASGO"},
{"MEMORY", "position", R"RASGO(Where in the buffer (0=most recent, up to 3 s ago; 1=oldest) the grains start reading.)RASGO"},
{"MEMORY", "spray", R"RASGO(Spreads each grain's starting position — from an exact read to a cloud blurred in time.)RASGO"},
{"MOUSSE", "fatigue", R"RASGO(Rasgo deviation: each hit softens the foam a little, which hardens again in ~6 s — repeated hits sink deeper and deeper.)RASGO"},
{"MOUSSE", "force", R"RASGO(The force of each hit (HIT or the autonomous taps).)RASGO"},
{"MOUSSE", "in:hit", R"RASGO(Each trigger is a push that decays in ~80 ms.)RASGO"},
{"MOUSSE", "in:press", R"RASGO(Continuous pressure (0–1): a finger resting on the foam.)RASGO"},
{"MOUSSE", "out:depth", R"RASGO(How far the foam is pressed in (0–1): a soft envelope.)RASGO"},
{"MOUSSE", "out:rest", R"RASGO(Gate on while the foam is at rest.)RASGO"},
{"MOUSSE", "out:speed", R"RASGO(The speed of the deformation (0–1): high at the hit, low on the slow return.)RASGO"},
{"MOUSSE", "rate", R"RASGO(With HIT free, the foam is tapped by itself at this rate (0.05–4 Hz), with the force varying by seeded chance.)RASGO"},
{"MOUSSE", "recover", R"RASGO(How many times slower it returns than it sinks (1–8).)RASGO"},
{"MOUSSE", "slow", R"RASGO(How much of the deformation is slow (fluid) and how much instant (spring): 0 = rubber, 1 = memory foam.)RASGO"},
{"MOUSSE", "stiff", R"RASGO(The foam's stiffness: soft (sinks a lot) ↔ hard (sinks little).)RASGO"},
{"MOUSSE", "visc", R"RASGO(Viscosity: the time of the slow part (0.05–8 s) — how long the fluid takes to flow.)RASGO"},
{"MULT", "dual", R"RASGO(1→4 mode (off) or two independent 1→2 multiples (on, A-180-2): out1/2 follow IN, out3/4 follow IN2.)RASGO"},
{"MULT", "in:in", R"RASGO(Input — feeds the 4 outputs (or only out1/2 in DUAL mode).)RASGO"},
{"MULT", "in:in2", R"RASGO(2nd input — used only in DUAL mode, feeds out3/4.)RASGO"},
{"MULT", "offset1", R"RASGO(Constant added to output 1 — with no IN connected, it becomes a manual voltage source.)RASGO"},
{"MULT", "offset2", R"RASGO(Constant added to output 2.)RASGO"},
{"MULT", "offset3", R"RASGO(Constant added to output 3.)RASGO"},
{"MULT", "offset4", R"RASGO(Constant added to output 4.)RASGO"},
{"MULT", "out:out1", R"RASGO(Output 1: SCALE1·input + OFFSET1.)RASGO"},
{"MULT", "out:out2", R"RASGO(Output 2: SCALE2·input + OFFSET2.)RASGO"},
{"MULT", "out:out3", R"RASGO(Output 3: SCALE3·input + OFFSET3.)RASGO"},
{"MULT", "out:out4", R"RASGO(Output 4: SCALE4·input + OFFSET4.)RASGO"},
{"MULT", "scale1", R"RASGO(Attenuverter for output 1 (negative inverts).)RASGO"},
{"MULT", "scale2", R"RASGO(Attenuverter for output 2.)RASGO"},
{"MULT", "scale3", R"RASGO(Attenuverter for output 3 (in DUAL, it follows IN2).)RASGO"},
{"MULT", "scale4", R"RASGO(Attenuverter for output 4 (in DUAL, it follows IN2).)RASGO"},
{"MULT", "slew", R"RASGO(Smooths the 4 outputs (shared).)RASGO"},
{"NOISE", "in:in", R"RASGO(Source for the S&H to sample — with no cable, the S&H uses the internal draw instead of the input.)RASGO"},
{"NOISE", "in:trigger", R"RASGO(External trigger for the S&H/SMTH — present, it replaces the internal clock (RATE).)RASGO"},
{"NOISE", "out:bit", R"RASGO(1 bipolar bit (+1/−1) straight from the generator, flipping at every sample — a hard digital texture, different from the S&H's step (which only changes on the pulse).)RASGO"},
{"NOISE", "out:blue", R"RASGO(Blue noise — rises ~3 dB/octave (differentiated white). Higher/harsher than white.)RASGO"},
{"NOISE", "out:brown", R"RASGO(Brown noise — falls ~6 dB/octave (a filtered random walk). Low, muffled.)RASGO"},
{"NOISE", "out:pink", R"RASGO(Pink noise — falls ~3 dB/octave (a 7-pole Kellet filter). More natural for wind/sea than white.)RASGO"},
{"NOISE", "out:sh", R"RASGO(Sample & hold — it holds a new value at each pulse (RATE or TRIG), in steps.)RASGO"},
{"NOISE", "out:smooth", R"RASGO(A voltage that slides to a new target at each pulse, instead of jumping — the Buchla 266 "smooth random".)RASGO"},
{"NOISE", "out:violet", R"RASGO(Violet noise — rises ~6 dB/octave (differentiated twice). Even higher than blue — almost nothing but hiss.)RASGO"},
{"NOISE", "out:white", R"RASGO(White noise — equal energy at every frequency.)RASGO"},
{"NOISE", "poisson", R"RASGO(Swaps the periodic internal clock for a FREE Poisson process — SH/SMTH update at random times, not tied to a clock. RATE becomes the mean rate.)RASGO"},
{"NOISE", "rate", R"RASGO(Pace of the S&H/smooth internal clock (ignored if TRIG is connected).)RASGO"},
{"NOISE", "slew", R"RASGO(Glide time of the SMTH output — 0 is instant (a step, it becomes almost an S&H), 1 is ~2 s of sliding.)RASGO"},
{"NOISE", "spread", R"RASGO(Pulls the draw from uniform towards bell-shaped (the average of 4 uniforms) — it affects SH and SMTH.)RASGO"},
{"OPERATOR", "algo", R"RASGO(Which operator modulates which — 8 algorithms, from 0 (A→B→C→D, the most 'FM') to 7 (A,B,C,D in parallel, additive/organ).)RASGO"},
{"OPERATOR", "drift", R"RASGO(Slow, independent micro-detune per operator. Deterministic (a sum of sines, no RNG). 0 = no detune.)RASGO"},
{"OPERATOR", "feedback", R"RASGO(Operator A modulates its own phase (the average of the last 2 samples, DX7-style).)RASGO"},
{"OPERATOR", "fine", R"RASGO(Fine tuning in cents (±100).)RASGO"},
{"OPERATOR", "freq", R"RASGO(Frequency of operator A. 1 V/oct through the 1V/O input.)RASGO"},
{"OPERATOR", "in:index", R"RASGO(CV added to INDEX.)RASGO"},
{"OPERATOR", "in:pitch", R"RASGO(1 V/oct CV.)RASGO"},
{"OPERATOR", "index", R"RASGO(Global modulation depth. 0 = the 4 operators are pure sinusoids; 1 ≈ 6 cycles of phase deviation (very bright).)RASGO"},
{"OPERATOR", "out:out", R"RASGO(The sum of the algorithm's carriers, ÷ the number of carriers + softclip.)RASGO"},
{"OPERATOR", "ratio_b", R"RASGO(Frequency ratio of operator B relative to A, QUANTISED: 0.5 / 1 / 1.5 / 2 / 2.5 / 3 / 4 / 5 / 7 / 9.)RASGO"},
{"OPERATOR", "ratio_c", R"RASGO(Ratio of operator C (the same table).)RASGO"},
{"OPERATOR", "ratio_d", R"RASGO(Ratio of operator D (the same table).)RASGO"},
