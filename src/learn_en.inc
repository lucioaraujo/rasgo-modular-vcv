{"OSC", "out:saw", R"RASGO(Sawtooth output (PolyBLEP antialiasing).)RASGO"},
{"OSC", "out:sine", R"RASGO(Sine output.)RASGO"},
{"OSC", "out:sub", R"RASGO(Sub-oscillator (one or two octaves below).)RASGO"},
{"OSC", "out:tri", R"RASGO(Triangle output.)RASGO"},
