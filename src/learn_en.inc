{"PENDULUM", "out:x1", R"RASGO(Horizontal position of the upper tip (−1..1).)RASGO"},
{"PENDULUM", "out:x2", R"RASGO(Horizontal position of the lower tip (−1..1) — the most chaotic.)RASGO"},
{"PENDULUM", "out:y1", R"RASGO(Vertical position of the upper tip (−1..1).)RASGO"},
{"PENDULUM", "out:y2", R"RASGO(Vertical position of the lower tip (−1..1).)RASGO"},
{"PENDULUM", "ratio", R"RASGO(The length of the lower arm relative to the upper (0.3–2).)RASGO"},
