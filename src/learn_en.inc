{"ORBIT", "in:nudge", R"RASGO(A push on planet 1: the orbit changes shape.)RASGO"},
{"ORBIT", "in:speed_cv", R"RASGO(CV on the speed (+1 = double).)RASGO"},
{"ORBIT", "light", R"RASGO(Light-time: the conjunction arrives delayed by the distance between the planets (0 = at once; 1 = up to ~1 s).)RASGO"},
{"ORBIT", "mass", R"RASGO(How much the planets pull each other: high, the orbits dissolve into chaos.)RASGO"},
{"ORBIT", "out:conj", R"RASGO(A pulse at conjunction: planets 1 and 2 aligned with the sun (with light-time).)RASGO"},
{"ORBIT", "out:dist", R"RASGO(The distance between planets 1 and 2 (0–1).)RASGO"},
{"ORBIT", "out:peri", R"RASGO(A pulse when planet 1 passes the point nearest the sun.)RASGO"},
{"ORBIT", "out:x1", R"RASGO(Planet 1's X position (−1..1).)RASGO"},
{"ORBIT", "out:x2", R"RASGO(Planet 2's X position.)RASGO"},
{"ORBIT", "out:y1", R"RASGO(Planet 1's Y position.)RASGO"},
{"ORBIT", "out:y2", R"RASGO(Planet 2's Y position.)RASGO"},
{"ORBIT", "planets", R"RASGO(How many planets (2 or 3).)RASGO"},
